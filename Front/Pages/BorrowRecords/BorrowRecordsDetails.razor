@page "/BorrowRecords/Details/{Id:int}"
@attribute [Authorize(Roles = "Admin,Client")]
@inject BorrowRecordsServices borrowRecordsServices
@inject LivresServices livresServices
@inject NavigationManager NavigationManager

<PageTitle>Détails de l'Emprunt</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView Roles="Admin,Client">
        <Authorized>
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        @if (isLoading)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-warning" role="status"></div>
                                <p class="mt-3">Chargement des détails...</p>
                            </div>
                        }
                        else if (BorrowRecord == null)
                        {
                            <div class="alert alert-danger text-center py-5">
                                <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                                <h4>Emprunt introuvable</h4>
                                <a href="/BorrowRecords" class="btn btn-primary mt-3">Retour à la liste</a>
                            </div>
                        }
                        else
                        {
                            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                                <div class="card-header bg-warning text-dark text-center py-4">
                                    <i class="fas fa-book-reader fa-4x mb-3"></i>
                                    <h3 class="mb-0 fw-bold">Détails de l'Emprunt</h3>
                                </div>
                                <div class="card-body p-5">
                                    <div class="mb-4">
                                        <h5 class="text-muted mb-2">Livre emprunté</h5>
                                        <h4 class="fw-bold">@BorrowRecord.Livre?.Title</h4>
                                        <p class="text-muted">@BorrowRecord.Livre?.Author</p>
                                    </div>

                                    <hr />

                                    <div class="row g-4 mb-4">
                                        <div class="col-6">
                                            <div class="p-3 bg-light rounded-3">
                                                <h6 class="text-muted mb-1">Date d'emprunt</h6>
                                                <p class="fw-bold mb-0">@BorrowRecord.BorrowDate.ToShortDateString()</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-3 bg-light rounded-3">
                                                <h6 class="text-muted mb-1">Date de retour</h6>
                                                @if (BorrowRecord.ReturnDate.HasValue)
                                                {
                                                    <p class="fw-bold text-success mb-0">@BorrowRecord.ReturnDate.Value.ToShortDateString()</p>
                                                }
                                                else
                                                {
                                                    <p class="fw-bold text-danger mb-0">Non retourné</p>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    

                                    <hr />

                                    <div class="d-grid gap-2">
                                       
                                            <button class="btn btn-success btn-lg" @onclick="ReturnBook">
                                                <i class="fas fa-undo me-2"></i>Retourner le livre
                                            </button>
                                        
                                        <AuthorizeView Roles="Admin">
                                            <Authorized Context="adminContext">
                                                <button class="btn btn-danger btn-lg" @onclick="DeleteRecord">
                                                    <i class="fas fa-trash me-2"></i>Supprimer
                                                </button>
                                            </Authorized>
                                        </AuthorizeView>
                                        <a href="/BorrowRecords" class="btn btn-outline-secondary">
                                            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="container my-5 text-center">
                <div class="alert alert-danger shadow-lg p-5">
                    <h2 class="text-danger mb-4">🚫 Accès refusé</h2>
                    <p class="lead">Vous devez être connecté pour voir les détails de l'emprunt.</p>
                    <NavLink class="btn btn-primary btn-lg mt-3" href="/login">Se connecter</NavLink>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    [Parameter]
    public int Id { get; set; }
    public Livre? Livre { get; set; }

    public BorrowRecord? BorrowRecord { get; set; }
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            BorrowRecord = await borrowRecordsServices.GetBorrowRecordAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReturnBook()
    {
        if (BorrowRecord == null) return;

        var success = await borrowRecordsServices.ReturnBookAsync(BorrowRecord.BorrowRecordID);
        if (success)
        {
            // Mettre à jour l'affichage local
            BorrowRecord.ReturnDate = DateTime.Now;
            if (BorrowRecord.Livre != null)
            {
                BorrowRecord.Livre.IsBorrowed = false;
            }
            NavigationManager.NavigateTo("/BorrowRecords");
        }
    }



    private async Task DeleteRecord()
    {
        if (BorrowRecord == null) return;
        
        var success = await borrowRecordsServices.DeleteBorrowRecord(BorrowRecord.BorrowRecordID);
        if (success)
        {
            NavigationManager.NavigateTo("/BorrowRecords");
        }
    }
}
