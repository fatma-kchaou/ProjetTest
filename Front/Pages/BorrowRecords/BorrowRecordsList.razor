@page "/BorrowRecords"
@attribute [Authorize(Roles = "Admin,Client")]
@inject NavigationManager NavigationManager
@inject BorrowRecordsServices BorrowRecordsServices
@inject AuthServices AuthServices

<PageTitle>Mes Emprunts</PageTitle>
<CascadingAuthenticationState>
        <AuthorizeView>

        <Authorized Context="authContext">
<div class="container my-5">
    <h3 class="text-center mb-4 text-warning">📅 Mes Emprunts</h3>

  

        @if (FilteredBorrowRecords == null)
        {
            <p><em>Chargement...</em></p>
        }
        else if (!FilteredBorrowRecords.Any())
        {
            <p class="text-muted text-center">Aucun emprunt pour le moment.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in FilteredBorrowRecords)
                {
                    <div class="col-md-4">
                        <div class="card shadow h-100">
                            <div class="card-body">
                                <h5 class="card-title">@item.Livre?.Title</h5>
                                <p class="card-text"><i class="fas fa-calendar me-2"></i>Emprunté le : @item.BorrowDate.ToShortDateString()</p>
                                <p class="card-text">
                                    <i class="fas fa-undo me-2"></i>Retour : 
                                    @if (item.ReturnDate.HasValue)
                                    {
                                        <span class="text-success">@item.ReturnDate.Value.ToShortDateString()</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">Non retourné</span>
                                    }
                                </p>
                                        
                            </div>
                            <div class="card-footer d-flex gap-2 justify-content-between">
                                <a href="/BorrowRecords/Details/@item.BorrowRecordID" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i> Détails
                                </a>
                                @if (!item.ReturnDate.HasValue)
                                {
                                    <button class="btn btn-success btn-sm" @onclick="() => ReturnBook(item.BorrowRecordID)">
                                        <i class="fas fa-undo"></i> Retourner
                                    </button>
                                }
                                <AuthorizeView Roles="Admin">
                                    <Authorized Context="adminContext">
                                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteBorrowRecord(item.BorrowRecordID)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    
</div>
        </Authorized>

        <NotAuthorized>
            <div class="container my-5 text-center">
                <div class="alert alert-danger shadow-lg p-5">
                    <h2 class="text-danger mb-4">🚫 Accès refusé</h2>
                    <p class="lead">
                        Vous n'avez pas les droits nécessaires pour accéder à cette page.
                    </p>
                    <p>
                        Seuls les utilisateurs connectée peuvent voir le tableau de bord.
                    </p>
                    <NavLink class="btn btn-primary btn-lg mt-3" href="/login">
                        Se connecter
                    </NavLink>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>

</CascadingAuthenticationState>
@code {
    public List<BorrowRecord> BorrowRecords { get; set; } = new List<BorrowRecord>();
    public List<BorrowRecord> FilteredBorrowRecords { get; set; } = new List<BorrowRecord>(); // Filtrés
 

    protected override async Task OnInitializedAsync()
    {
        

        await LoadBorrowRecords();
    }

    private async Task LoadBorrowRecords()
    {
        BorrowRecords = await BorrowRecordsServices.GetBorrowRecordsAsync();
        FilteredBorrowRecords = BorrowRecords.ToList();
    }

    private void NavigateToCreate()
    {
        NavigationManager.NavigateTo("/BorrowRecords/Create");
    }

    private async Task DeleteBorrowRecord(int id)
    {
        var success = await BorrowRecordsServices.DeleteBorrowRecord(id);
        if (success)
        {
            await LoadBorrowRecords();
        }
    }

    private async Task ReturnBook(int id)
    {
        var success = await BorrowRecordsServices.ReturnBookAsync(id);
        if (success)
        {
            await LoadBorrowRecords();
        }
    }

    private async Task Logout()
    {
        await AuthServices.Logout();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}