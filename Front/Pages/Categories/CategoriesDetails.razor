@page "/Categories/Details/{Id:int}"
@inject CategoriesServices CategoriesServices
@inject AuthServices AuthServices
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject LivresServices LivresServices

<PageTitle>Détails de la Catégorie</PageTitle>

<div class="container my-5">
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status"></div>
        </div>
    }
    else if (Category == null)
    {
        <div class="alert alert-danger">Catégorie non trouvée.</div>
    }
    else
    {
        <div class="card shadow-lg">
            @if (!string.IsNullOrEmpty(Category.Image))
            {
                <img src="@Category.Image" class="card-img-top" alt="@Category.CategoryName" style="max-height: 300px; object-fit: cover;" />
            }
            <div class="card-body">
                <h2 class="card-title text-info fw-bold">@Category.CategoryName</h2>
                @if (!string.IsNullOrEmpty(Category.Description))
                {
                    <p class="lead">@Category.Description</p>
                }
                <hr />
                <p><strong>Nombre de livres :</strong> @(Category.Livres?.Count ?? 0)</p>
            </div>
                <div class="card-footer bg-transparent border-0">
                    <button class="btn btn-secondary me-2" @onclick='() => NavigationManager.NavigateTo("/Categories")'>
                        ← Retour à la liste
                    </button>

                <AuthorizeView Roles="Admin">
    <Authorized>
                    <a href="/Categories/Edit/@Category.CategoryID" class="btn btn-warning me-2">
                        <i class="fas fa-edit"></i> Modifier
                    </a>
                    <button class="btn btn-danger" @onclick="DeleteCategory">
                        <i class="fas fa-trash"></i> Supprimer
                    </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    public Category? Category { get; set; }
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Category = await CategoriesServices.GetCategoryAsync(Id);
            // Livres are now included in the GetCategoryAsync response
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteCategory()
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer cette catégorie et tous ses livres ?");
        if (confirm)
        {
            var success = await CategoriesServices.DeleteCategory(Id);
            if (success)
            {
                NavigationManager.NavigateTo("/Categories");
            }
        }
    }
}