@page "/Categories"
@inject CategoriesServices categoriesServices
@inject NavigationManager navigationManager

<PageTitle>Catégories</PageTitle>

<div class="container my-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-info fw-bold">📂 Catégories de Livres</h1>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <a href="/Categories/Create" class="btn btn-info"><i class="fas fa-plus"></i> Nouvelle catégorie</a>
            </Authorized>
        </AuthorizeView>
    </div>
      
    @if (Categories == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-info" role="status"></div>
        </div>
    }
    else if (!Categories.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-info-circle fa-3x mb-3"></i>
            <h4>Aucune catégorie enregistrée</h4>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cat in Categories)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 hover-lift">
                        @if (!string.IsNullOrEmpty(cat.Image))
                        {
                            <img src="@cat.Image" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@cat.CategoryName">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-folder-open fa-4x text-muted"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@cat.CategoryName</h5>
                            <p class="card-text text-muted">@cat.Description</p>
                        </div>
                       
                        <div class="mt-auto">
                            <a href="/Categories/Details/@cat.CategoryID" class="btn btn-outline-info btn-sm w-100">
                                <i class="fas fa-eye me-1"></i> Détails
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    public List<Category> Categories { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Categories = await categoriesServices.GetCategoriesAsync();
    }
}