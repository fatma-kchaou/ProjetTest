@page "/"
@inject NavigationManager Nav

<PageTitle>Accueil - Bibliothèque Centrale</PageTitle>

<div class="hero-section text-white text-center py-5 mb-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 15px;">
    <div class="container py-5">
        <h1 class="display-4 fw-bold mb-4">📚 Bibliothèque Centrale</h1>
        <p class="lead mb-5">Votre espace moderne de gestion de livres, salles et emprunts</p>
        <a href="/livres" class="btn btn-light btn-lg mx-2">Explorer les livres</a>
        <a href="/login" class="btn btn-outline-light btn-lg mx-2">Se connecter</a>
    </div>
</div>

<div class="container">
    <h2 class="text-center mb-5 text-primary fw-bold">Nos Services</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 hover-lift text-center p-4">
                <div class="icon-circle mb-4 mx-auto bg-primary text-white">
                    <i class="fas fa-book fa-2x"></i>
                </div>
                <h4>Livres</h4>
                <p>Consultez et empruntez parmi des milliers d'ouvrages dans toutes les catégories.</p>
                <a href="/livres" class="btn btn-outline-primary mt-3">Voir le catalogue →</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 hover-lift text-center p-4">
                <div class="icon-circle mb-4 mx-auto bg-success text-white">
                    <i class="fas fa-door-open fa-2x"></i>
                </div>
                <h4>Salles</h4>
                <p>Réservez une salle de lecture ou de travail en quelques clics.</p>
                <a href="/SalleReservations" class="btn btn-outline-success mt-3">Réserver une salle →</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 hover-lift text-center p-4">
                <div class="icon-circle mb-4 mx-auto bg-info text-white">
                    <i class="fas fa-chart-bar fa-2x"></i>
                </div>
                <h4>Statistiques</h4>
                <p>Suivez les emprunts, les catégories populaires et l'activité de la bibliothèque.</p>
                <a href="/Dashboard" class="btn btn-outline-info mt-3">Voir le tableau de bord →</a>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-lift {
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .hover-lift:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .icon-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>