@page "/Livres/Create"
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager NavigationManager
@inject LivresServices LivresServices
@inject CategoriesServices categoriesServices
@inject ILocalStorageService LocalStorage
@using Blazored.LocalStorage
@inject AuthServices AuthServices
<PageTitle>Ajouter un Livre</PageTitle>
<CascadingAuthenticationState>
    <AuthorizeView Roles="Admin">
        <Authorized Context="authContext">
<div class="container my-5">
    <div class="card shadow-lg mx-auto" style="max-width: 700px;">
        <div class="card-body p-5">
            <h3 class="text-center mb-4 text-primary fw-bold">➕ Ajouter un nouveau Livre</h3>

            @if (isLoading)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Chargement des catégories...</span>
                    </div>
                </div>
            }
            else
            {
                <EditForm Model="Livre" OnValidSubmit="handleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Titre du livre <span class="text-danger">*</span></label>
                        <InputText @bind-Value="Livre.Title" class="form-control" placeholder="Ex: Le Petit Prince" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Auteur <span class="text-danger">*</span></label>
                        <InputText @bind-Value="Livre.Author" class="form-control" placeholder="Ex: Antoine de Saint-Exupéry" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Année de publication</label>
                        <InputNumber @bind-Value="Livre.Year" class="form-control" placeholder="Ex: 1943" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Catégorie <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="Livre.CategoryID" class="form-select">
                            <option value="0">-- Sélectionner une catégorie --</option>
                            @foreach (var cat in Categories)
                            {
                                <option value="@cat.CategoryID">@cat.CategoryName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Image de couverture</label>
                        <div class="input-group">
                            <InputText @bind-Value="Livre.Image" class="form-control" placeholder="URL directe ou sélectionnez un fichier" />
                            <label class="btn btn-outline-secondary input-group-text">
                                Choisir fichier
                                <InputFile OnChange="OnFileSelected" accept="image/*" style="display:none;" />
                            </label>
                        </div>
                        <div class="form-text text-muted">
                            Vous pouvez coller une URL ou uploader une image (max 5 Mo).
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Livre.Image))
                        {
                            <div class="mt-3 text-center">
                                <strong>Aperçu :</strong><br />
                                <img src="@Livre.Image"
                                     alt="Aperçu couverture"
                                     class="img-fluid rounded shadow-sm border"
                                     style="max-height: 350px; object-fit: contain;"
                                     onerror="this.src='https://via.placeholder.com/400x600?text=Image+non+valide'; this.onerror=null;" />
                            </div>
                        }
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save"></i> Créer le Livre
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>
        </Authorized>

        <NotAuthorized>
            <div class="container my-5 text-center">
                <div class="alert alert-danger shadow-lg p-5">
                    <h2 class="text-danger mb-4">🚫 Accès refusé</h2>
                    <p class="lead">
                        Vous n'avez pas les droits nécessaires pour accéder à cette page.
                    </p>
                    <p>
                        Seuls les administrateurs peuvent voir le tableau de bord.
                    </p>
                    <NavLink class="btn btn-primary btn-lg mt-3" href="/login">
                        Se connecter
                    </NavLink>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>
@code {
    public Livre Livre { get; set; } = new Livre();
    private List<Category> Categories { get; set; } = new List<Category>();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Chargement des catégories depuis l'API
            Categories = await categoriesServices.GetCategoriesAsync();

            // Si tu veux une catégorie par défaut (optionnel)
            // if (Categories.Any()) Livre.CategoryID = Categories.First().CategoryID;
        }
        catch (Exception ex)
        {
            // Gérer l'erreur (ex: afficher un message)
            Console.WriteLine($"Erreur chargement catégories : {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Force le re-rendu pour afficher le dropdown rempli
        }
    }

    private async Task handleSubmit()
    {
        var result = await LivresServices.CreateLivre(Livre);
        if (result != null)
        {
            NavigationManager.NavigateTo("/livres");
        }
        else
        {
            // Optionnel : afficher un message d'erreur
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 5 * 1024 * 1024) // 5 Mo max
        {
            // Tu peux ajouter un message d'erreur visible
            return;
        }

        try
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).ReadAsync(buffer);

            var base64 = Convert.ToBase64String(buffer);
            var mimeType = file.ContentType;
            Livre.Image = $"data:{mimeType};base64,{base64}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur upload : {ex.Message}");
        }

    }
    private async Task Logout()
    {
        await AuthServices.Logout();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}