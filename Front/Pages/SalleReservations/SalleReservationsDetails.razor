@page "/SalleReservations/Details/{Id:int}"
@attribute [Authorize(Roles = "Admin,Client")]
@inject SalleReservationsServices salleReservationsServices
@inject SallesServices sallesServices
@inject NavigationManager NavigationManager

<PageTitle>Détails de la Réservation</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView Roles="Admin,Client">
        <Authorized>
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        @if (isLoading)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-3">Chargement des détails...</p>
                            </div>
                        }
                        else if (Reservation == null)
                        {
                            <div class="alert alert-danger text-center py-5">
                                <i class="fas fa-exclamation-triangle fa-3x mb-3"></i>
                                <h4>Réservation introuvable</h4>
                                <a href="/SalleReservations" class="btn btn-primary mt-3">Retour à la liste</a>
                            </div>
                        }
                        else
                        {
                            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                                <div class="card-header bg-primary text-white text-center py-4">
                                    <i class="fas fa-calendar-check fa-4x mb-3"></i>
                                    <h3 class="mb-0 fw-bold">@Reservation.SalleReservationName</h3>
                                </div>
                                <div class="card-body p-5">
                                    <div class="mb-4">
                                        <h5 class="text-muted mb-2">Salle réservée</h5>
                                        <h4 class="fw-bold">
                                            <i class="fas fa-door-open me-2 text-success"></i>
                                            @(Salle?.SalleName ?? "Salle inconnue")
                                        </h4>
                                        @if (Salle != null)
                                        {
                                            <p class="text-muted">Capacité: @Salle.Capacity places</p>
                                        }
                                    </div>

                                    <hr />

                                    <div class="row g-4 mb-4">
                                        <div class="col-6">
                                            <div class="p-3 bg-light rounded-3">
                                                <h6 class="text-muted mb-1">Date de réservation</h6>
                                                <p class="fw-bold mb-0">@Reservation.ReservedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="p-3 bg-light rounded-3">
                                                <h6 class="text-muted mb-1">Date de libération</h6>
                                                @if (Reservation.ReleasedAt.HasValue)
                                                {
                                                    <p class="fw-bold text-success mb-0">@Reservation.ReleasedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                                }
                                                else
                                                {
                                                    <p class="fw-bold text-warning mb-0">En cours</p>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-4 text-center">
                                        <span class="badge @(Reservation.ReleasedAt.HasValue ? "bg-success" : "bg-primary") fs-6 px-4 py-2">
                                            @(Reservation.ReleasedAt.HasValue ? "Terminée" : "Active")
                                        </span>
                                    </div>

                                    <hr />

                                    <div class="d-grid gap-2">
                                        @if (!Reservation.ReleasedAt.HasValue)
                                        {
                                            <a href="/SalleReservations/Edit/@Reservation.SalleReservationID" class="btn btn-warning btn-lg">
                                                <i class="fas fa-edit me-2"></i>Modifier
                                            </a>
                                        }
                                        <button class="btn btn-danger btn-lg" @onclick="DeleteReservation">
                                            <i class="fas fa-trash me-2"></i>Annuler la réservation
                                        </button>
                                        <a href="/SalleReservations" class="btn btn-outline-secondary">
                                            <i class="fas fa-arrow-left me-2"></i>Retour à la liste
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="container my-5 text-center">
                <div class="alert alert-danger shadow-lg p-5">
                    <h2 class="text-danger mb-4">🚫 Accès refusé</h2>
                    <p class="lead">Vous devez être connecté pour voir les détails de la réservation.</p>
                    <NavLink class="btn btn-primary btn-lg mt-3" href="/login">Se connecter</NavLink>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    [Parameter]
    public int Id { get; set; }

    public SalleReservation? Reservation { get; set; }
    public Salle? Salle { get; set; }
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Reservation = await salleReservationsServices.GetSalleReservationAsync(Id);
            if (Reservation != null)
            {
                Salle = await sallesServices.GetSalleAsync(Reservation.SalleId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteReservation()
    {
        if (Reservation == null) return;
        
        var success = await salleReservationsServices.DeleteSalleReservation(Reservation.SalleReservationID);
        if (success)
        {
            NavigationManager.NavigateTo("/SalleReservations");
        }
    }
}
