@page "/SalleReservations/Edit/{Id:int}"
@attribute [Authorize(Roles = "Admin,Client")]
@inject SalleReservationsServices salleReservationsServices
@inject SallesServices sallesServices
@inject NavigationManager NavigationManager

<PageTitle>Modifier la Réservation</PageTitle>

<CascadingAuthenticationState>
    <AuthorizeView Roles="Admin,Client">
        <Authorized Context="authContext">
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card shadow-lg border-0 rounded-4">
                            <div class="card-header bg-warning text-dark text-center py-4">
                                <h3 class="mb-0 fw-bold">
                                    <i class="fas fa-edit me-2"></i>Modifier la Réservation
                                </h3>
                            </div>
                            <div class="card-body p-5">
                                @if (isLoading)
                                {
                                    <div class="text-center py-5">
                                        <div class="spinner-border text-warning" role="status"></div>
                                        <p class="mt-3">Chargement...</p>
                                    </div>
                                }
                                else if (Reservation == null)
                                {
                                    <div class="alert alert-danger">Réservation introuvable.</div>
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(errorMessage))
                                    {
                                        <div class="alert alert-danger">@errorMessage</div>
                                    }

                                    <EditForm Model="Reservation" OnValidSubmit="HandleSubmit">
                                        <DataAnnotationsValidator />
                                        <ValidationSummary class="text-danger mb-3" />

                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">Nom de la réservation</label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="fas fa-calendar-alt text-warning"></i>
                                                </span>
                                                <InputText @bind-Value="Reservation.SalleReservationName" class="form-control" />
                                            </div>
                                            <ValidationMessage For="@(() => Reservation.SalleReservationName)" class="text-danger" />
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">Salle</label>
                                            <InputSelect @bind-Value="Reservation.SalleId" class="form-select">
                                                @foreach (var salle in Salles)
                                                {
                                                    <option value="@salle.SalleID">@salle.SalleName (Capacité: @salle.Capacity)</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">Date de réservation</label>
                                            <InputDate @bind-Value="Reservation.ReservedAt" class="form-control" />
                                        </div>

                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">Date de libération (optionnel)</label>
                                            <InputDate @bind-Value="Reservation.ReleasedAt" class="form-control" />
                                            <small class="text-muted">Laisser vide si la réservation est toujours active</small>
                                        </div>

                                        <div class="d-grid gap-2">
                                            <button type="submit" class="btn btn-warning btn-lg shadow-sm" disabled="@isSubmitting">
                                                @if (isSubmitting)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                                }
                                                <i class="fas fa-save me-2"></i>Enregistrer
                                            </button>
                                            <a href="/SalleReservations" class="btn btn-outline-secondary">
                                                <i class="fas fa-arrow-left me-2"></i>Retour
                                            </a>
                                        </div>
                                    </EditForm>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="container my-5 text-center">
                <div class="alert alert-danger shadow-lg p-5">
                    <h2 class="text-danger mb-4">🚫 Accès refusé</h2>
                    <p class="lead">Vous devez être connecté pour modifier une réservation.</p>
                    <NavLink class="btn btn-primary btn-lg mt-3" href="/login">Se connecter</NavLink>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    [Parameter]
    public int Id { get; set; }

    public SalleReservation? Reservation { get; set; }
    public List<Salle> Salles { get; set; } = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Salles = await sallesServices.GetSallesAsync() ?? new List<Salle>();
            Reservation = await salleReservationsServices.GetSalleReservationAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (Reservation == null) return;
        
        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            var success = await salleReservationsServices.UpdateSalleReservation(Reservation);
            if (success)
            {
                NavigationManager.NavigateTo("/SalleReservations");
            }
            else
            {
                errorMessage = "Erreur lors de la mise à jour de la réservation.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
